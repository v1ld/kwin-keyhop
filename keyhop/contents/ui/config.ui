<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>KeyHopConfig</class>
 <widget class="QWidget" name="KeyHopConfig">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_warp">
     <property name="text"><string>Mouse pointer follows focus</string></property>
     <property name="toolTip"><string>When a window gets focus and the mouse pointer is not on it, move the mouse pointer to the centre of that window. A focus change made with the mouse never moves it.</string></property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="label_passThroughMs">
     <property name="text"><string>Windows passed through go back:</string></property>
     <property name="buddy"><cstring>kcfg_passThroughMs</cstring></property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="kcfg_passThroughMs">
     <property name="toolTip"><string>Switching by keyboard brings every window on the way to the front. A window that had focus for less than this goes back behind the windows that were in front of it as soon as focus moves on. Stay longer and it stays in front.</string></property>
     <property name="specialValueText"><string>Off (leave windows where they are)</string></property>
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>10000</number></property>
     <property name="singleStep"><number>100</number></property>
     <property name="prefix"><string>if focused under </string></property>
     <property name="suffix"><string> ms</string></property>
     <property name="value"><number>1000</number></property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_wrap">
     <property name="text"><string>Direction shortcuts: at the end of the row or column, carry on from the other end</string></property>
     <property name="toolTip"><string>"Window to the Left" and "Window to the Right" treat the windows on the desktop as one row, ordered by their centres. "Window Up" and "Window Down" move within the column of windows that share some horizontal span with the one you set off from. Bind the shortcuts in System Settings > Keyboard > Shortcuts.</string></property>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="label_excludeClasses">
     <property name="text"><string>Ignore window classes:</string></property>
     <property name="buddy"><cstring>kcfg_excludeClasses</cstring></property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QLineEdit" name="kcfg_excludeClasses">
     <property name="text"><string>plasmashell,krunner,ksmserver-logout-greeter</string></property>
     <property name="toolTip"><string>Comma-separated. Focus going to these windows is ignored altogether.</string></property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_debug">
     <property name="text"><string>Log what the script does (journalctl --user -b | grep keyhop)</string></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
